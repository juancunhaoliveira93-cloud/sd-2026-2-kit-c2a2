# ------------------------------------------------------------------
# Copie para .env  (cp .env.example .env).
# O `docker compose` le o .env automaticamente. Rodando SEM docker,
# o .env NAO e lido: use `export VARIAVEL=valor` no terminal.
# NUNCA faca commit do .env (ja esta no .gitignore).
# ------------------------------------------------------------------

# --- LLM ---------------------------------------------------------
# Deixe LLM_API_KEY vazia para usar o MODO SIMULADO (offline)
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODELO=gpt-4o-mini

# --- Resiliencia da chamada ao LLM (servico de geracao) ----------
# Tempo-limite, em segundos, de CADA tentativa
LLM_TIMEOUT=10
# Tentativas por pergunta (espera 0.5s, 1s, ... entre elas)
LLM_TENTATIVAS=3
# Perguntas que falham (ja esgotadas as tentativas) ate o circuito abrir
DISJUNTOR_LIMITE=3
# Segundos com o circuito aberto antes de testar o LLM de novo
DISJUNTOR_ESPERA=20

# --- Recuperacao -------------------------------------------------
# Descarta trechos com similaridade menor ou igual a este valor
SCORE_MINIMO=0.0

# --- Execucao LOCAL (sem docker). No docker-compose ja vem configurado.
URL_INGESTAO=http://localhost:8001
URL_RECUPERACAO=http://localhost:8002
REDIS_URL=redis://localhost:6379/0
DADOS_DIR=dados
